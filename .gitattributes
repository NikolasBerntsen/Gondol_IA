* text=auto

# Scripts y configs que se ejecutan dentro de contenedores Linux o con bash: siempre LF.
*.sh text eol=lf
*.envsh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.conf text eol=lf
frontend/nginx/njs/*.js text eol=lf
*.template text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf

# Scripts de PowerShell: CRLF (convención de Windows).
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.jar binary
