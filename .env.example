# =====================================================================
# GondolIA - variables de entorno
# ./start.sh copia este archivo a .env la primera vez y genera JWT_SECRET.
# Después de editar .env, aplicá los cambios con: ./start.sh restart
#
# Formato: CLAVE=valor, sin espacios alrededor del "=" y con los comentarios
# en su propia línea. Si un valor lleva "$", escribilo como "$$".
# =====================================================================

# ---------------------------------------------------------------------
# Puertos publicados en esta PC
# ---------------------------------------------------------------------
# HTTP para usar desde la misma PC: http://localhost:8080
HTTP_PORT=8080
# HTTPS para celulares y otras PCs de la red: https://<IP-de-la-PC>:8443
HTTPS_PORT=8443
# Postgres para herramientas (DBeaver, psql, backend local). Solo escucha en 127.0.0.1.
DB_PORT=5433

# ---------------------------------------------------------------------
# Base de datos (PostgreSQL 16)
# ---------------------------------------------------------------------
# Se aplican al crear la base por primera vez. Si los cambiás después,
# borrá los datos con ./start.sh reset para que tomen efecto.
POSTGRES_DB=gondolia
POSTGRES_USER=gondolia
POSTGRES_PASSWORD=gondolia

# ---------------------------------------------------------------------
# Autenticación (JWT HS256)
# ---------------------------------------------------------------------
# Secreto para firmar los tokens (64+ caracteres). Si queda vacío,
# start.sh genera uno aleatorio. Cambiarlo cierra todas las sesiones.
JWT_SECRET=
# Horas de vida de cada sesión.
JWT_EXPIRATION_HOURS=12

# ---------------------------------------------------------------------
# Datos iniciales
# ---------------------------------------------------------------------
# true: carga los comercios, sucursales y datos demo (180 días de ventas)
# si la base todavía no tiene comercios.
APP_SEED_DEMO=true
# true: crea un comercio mínimo de prueba ("Comercio de Prueba", 2 sucursales)
# para desarrollo. Como crea comercios antes que el seed, si lo activás con la
# base vacía no se cargan los datos demo.
APP_DEV_FIXTURE=false
# Dueño de GondolIA que se crea si todavía no existe ninguno.
APP_BOOTSTRAP_OWNER_EMAIL=dueno@gondolia.app
APP_BOOTSTRAP_OWNER_PASSWORD=Gondolia2026!

# ---------------------------------------------------------------------
# Integraciones y región
# ---------------------------------------------------------------------
# Autocompletar productos por código de barras con Open Food Facts (requiere internet).
APP_OPENFOODFACTS_ENABLED=true
# Zona horaria del negocio (define qué es "hoy" para vencimientos y ventas).
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ---------------------------------------------------------------------
# Certificado HTTPS local
# ---------------------------------------------------------------------
# IPs de esta PC en la red, separadas por coma. Vacío = start.sh las detecta
# en cada arranque. Completalo solo si la detección no encuentra la IP correcta.
LAN_IPS=
# Hostnames extra para el certificado, separados por coma (ej.: mi-pc.local).
CERT_HOSTNAMES=

# ---------------------------------------------------------------------
# Avanzado (opcional)
# ---------------------------------------------------------------------
# Orígenes que el backend acepta como CORS, separados por coma. En Docker no hace falta:
# nginx sirve el frontend y la API desde el mismo origen y les borra el header Origin.
# Solo se usa cuando el navegador entra desde otro origen (el dev server de Vite, que ya
# viene contemplado por defecto, o un dominio propio delante de la app).
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opciones de la JVM del backend. Por defecto usa hasta el 40% de la memoria
# asignada a Docker. Ejemplo para PCs con poca memoria:
# JAVA_OPTS=-Xmx768m -XX:+ExitOnOutOfMemoryError
